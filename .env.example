TELEGRAM_BOT_TOKEN=
REDIS_URL=redis://redis:6379/0
CACHE_TTL=300
# Публичный HTTPS-адрес для webhook (например https://bot.example.com). Пусто = long polling.
WEBHOOK_URL=
# Секрет в пути webhook и заголовке X-Telegram-Bot-Api-Secret-Token (A-Z, a-z, 0-9, _ и -)
WEBHOOK_SECRET=
CACHE_LOG_LEVEL=INFO
LOG_LEVEL=INFO
